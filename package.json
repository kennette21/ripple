{
  "name": "ripple",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package --error-on-fail",
    "dev-start": "node scripts/dev-start.js",
    "dev-start:reset": "node scripts/dev-start.js --reset-db",
    "test:notifications": "node --test scripts/device-notifications.test.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "inspect:ios": "node scripts/inspect-ios.js",
    "inspect:start": "node scripts/inspect-ios.js --start",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:e2e:comments": "maestro test e2e/maestro/comments.yaml",
    "test:e2e:search-follow": "maestro test e2e/maestro/search-follow.yaml",
    "test:e2e:privacy": "maestro test e2e/maestro/private-post-owner.yaml e2e/maestro/private-post-visitor.yaml"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.1.1",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.8",
    "blurhash": "^2.0.5",
    "date-fns": "^4.1.0",
    "expo": "~58.0.21",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-contacts": "~58.0.10",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.88.1",
    "react-native-draggable-flatlist": "4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
